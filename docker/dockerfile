FROM php:8.2-apache

# Imposta le variabili d'ambiente
ENV APACHE_DOCUMENT_ROOT=/var/www/html
ENV PHP_APP_ROOT=/var/www/php
ENV IMG_ROOT=/var/www/img

# Installa le dipendenze
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    curl \
    default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

# Installa le estensioni PHP
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
    gd \
    mysqli \
    pdo \
    pdo_mysql \
    zip \
    opcache

# Configura Apache per servire anche la cartella img e processare PHP nei file HTML
RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf && \
    sed -i 's/Listen 80/Listen 8080/g' /etc/apache2/ports.conf && \
    sed -ri -e 's/.*<VirtualHost \*:80>.*/<VirtualHost *:8080>/g' \
           -e 's#/var/www/html#${APACHE_DOCUMENT_ROOT}#g' \
           -e 's#</VirtualHost>#\n\t<Directory ${APACHE_DOCUMENT_ROOT}>\n\t\tOptions Indexes FollowSymLinks\n\t\tAllowOverride All\n\t\tRequire all granted\n\t\tAddType application/x-httpd-php .html .php\n\t\tAddHandler application/x-httpd-php .html .php\n\t</Directory>\n\tAlias /php/ ${PHP_APP_ROOT}/\n\t<Directory ${PHP_APP_ROOT}>\n\t\tOptions Indexes FollowSymLinks\n\t\tAllowOverride All\n\t\tRequire all granted\n\t\tAddType application/x-httpd-php .html .php\n\t\tAddHandler application/x-httpd-php .html .php\n\t</Directory>\n\tAlias /img/ ${IMG_ROOT}/\n\t<Directory ${IMG_ROOT}>\n\t\tOptions Indexes FollowSymLinks\n\t\tAllowOverride All\n\t\tRequire all granted\n\t</Directory>\n</VirtualHost>#g' \
        /etc/apache2/sites-available/000-default.conf

# Configura PHP per file .html
RUN echo "AddType application/x-httpd-php .html .php" >> /etc/apache2/apache2.conf && \
    echo "AddHandler application/x-httpd-php .html .php" >> /etc/apache2/apache2.conf

# Crea un file di configurazione PHP per i file HTML
RUN echo "<FilesMatch \".+\.html$\">" > /etc/apache2/conf-available/html-php.conf && \
    echo "    SetHandler application/x-httpd-php" >> /etc/apache2/conf-available/html-php.conf && \
    echo "</FilesMatch>" >> /etc/apache2/conf-available/html-php.conf

# Abilita i moduli e configurazioni
RUN a2enmod rewrite headers && \
    a2enconf html-php

# Crea le directory
RUN mkdir -p ${APACHE_DOCUMENT_ROOT} ${IMG_ROOT}

# Espone la porta
EXPOSE 8080

# Imposta i permessi
RUN chown -R www-data:www-data /var/www && \
    chmod -R 755 /var/www

# Comando di avvio
CMD ["apache2-foreground"]